{
    "name": "ahmad-chebbo/laravel-whishpay",
    "description": "An Unofficial Laravel package for Whish Pay integration",
    "type": "library",
    "license": "MIT",
    "version": "1.1.0",
    "authors": [
        {
            "name": "Ahmad Chebbo",
            "email": "ahmad.m.chebbo@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "AhmadChebbo\\WhishPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhmadChebbo\\WhishPay\\Providers\\WhishPayServiceProvider"
            ],
            "aliases": {
                "WhishPay": "AhmadChebbo\\WhishPay\\Facades\\WhishPay"
            }
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
